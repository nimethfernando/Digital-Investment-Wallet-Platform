# Avora Bank - Production Environment Configuration Template
# Server Configuration
PORT=5000
NODE_ENV=production
API_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000

# Authentication & Security (Server-Side Only)
JWT_SECRET=replace-with-at-least-32-chars-random-cryptographic-salt
ADMIN_JWT_SECRET=replace-with-admin-dedicated-32-chars-random-salt
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Database Configuration (MariaDB / MySQL InnoDB)
DATABASE_URL="mysql://username:password@host:3306/database_name"

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=notifications@avorabank.com
EMAIL_PASS=your-secure-app-password
EMAIL_FROM="Avora Bank <notifications@avorabank.com>"
ADMIN_NOTIFICATION_EMAIL=admin@avorabank.com

# Platform Settings
INITIAL_ADMIN_EMAIL=admin@avorabank.com
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword2026!
UPLOAD_DIR="./uploads"

# Next.js Client Environment (for apps/web)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_PLATFORM_NAME="Avora Bank"

