datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum JournalReferenceType {
  DEPOSIT
  PACKAGE_PURCHASE
  MONTHLY_RETURN
  PRINCIPAL_RELEASE
  WITHDRAWAL_REQUEST
  WITHDRAWAL_SETTLEMENT
  WITHDRAWAL_REJECTED
  P2P_TRANSFER
  P2P_ESCROW_LOCK
  P2P_ESCROW_RELEASE
  EXCHANGE_BUY
  EXCHANGE_SELL
  OTC_DEPOSIT_LOCK
  OTC_DEPOSIT_REFUND
  P2P_DEPOSIT_LOCK
  P2P_DEPOSIT_REFUND
  OTC_TRADE_SETTLEMENT
  GLOBAL_TRANSFER
  INVESTMENT_ALLOCATION
  INVESTMENT_PROFIT_SHARE
  INVESTMENT_DISTRIBUTION
  FEE
  ADJUSTMENT
  REVERSAL
}

enum PackageStatus {
  PENDING_PAYMENT
  ACTIVE
  MATURED
  WITHDRAWAL_REQUESTED
  SETTLED
  CANCELLED
}

enum ReturnStatus {
  CREDITED
  PAUSED
  REVERSED
}

enum WithdrawalType {
  MONTHLY_RETURNS
  PRINCIPAL_RELEASE
}

enum PayoutMethod {
  BANK_TRANSFER
  USDT_WALLET
  CASH_PICKUP_TBILISI
  PLATFORM_WALLET
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  SETTLED
  REJECTED
}

enum ExchangeOrderType {
  BUY_USDT
  SELL_USDT
}

enum ExchangeStatus {
  QUOTE_PENDING
  AWAITING_DEPOSIT
  DEPOSIT_SUBMITTED
  VERIFYING
  PROCESSING_PAYOUT
  COMPLETED
  CANCELLED
  EXPIRED
}

enum P2PSide {
  BUY
  SELL
}

enum P2POfferStatus {
  OPEN
  PAUSED
  FILLED
  CANCELLED
}

enum P2POrderStatus {
  PENDING_PAYMENT
  PAYMENT_SENT
  COMPLETED
  DISPUTED
  CANCELLED
}

enum InquiryType {
  GENERAL
  INVESTMENT_ENQUIRY
  EXCHANGE_ENQUIRY
  START_PARTNERSHIP
}

enum TransactionType {
  DEPOSIT
  PACKAGE_PURCHASE
  MONTHLY_RETURN
  PRINCIPAL_RELEASE
  WITHDRAWAL_REQUEST
  WITHDRAWAL_SETTLEMENT
  P2P_TRANSFER_OUT
  P2P_TRANSFER_IN
  EXCHANGE_BUY
  EXCHANGE_SELL
  CARD_PAYMENT
  OTC_DEPOSIT_LOCK
  OTC_DEPOSIT_REFUND
  P2P_DEPOSIT_LOCK
  P2P_DEPOSIT_REFUND
  OTC_TRADE
  GLOBAL_TRANSFER_OUT
  GLOBAL_TRANSFER_FEE
  INVESTMENT_ALLOCATION
  INVESTMENT_FEE
  INVESTMENT_PROFIT_SHARE
  INVESTMENT_DISTRIBUTION
  FEE
  ADJUSTMENT
  REVERSAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  APPROVED
  DECLINED
  FAILED
  REVERSED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                     String     @id @default(uuid())
  email                  String     @unique
  passwordHash           String
  role                   Role       @default(USER)
  firstName              String?
  lastName               String?
  phone                  String?
  kycStatus              KycStatus  @default(NOT_STARTED)
  twoFactorEnabled       Boolean    @default(false)
  twoFactorSecret        String?
  withdrawalLockedUntil  DateTime?
  passwordChangedAt      DateTime?
  status                 UserStatus @default(ACTIVE)
  mustChangePassword     Boolean    @default(false)
  emailVerified          Boolean    @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  otcDepositLocked       Decimal    @default(0.00000000) @db.Decimal(20, 8)
  p2pDepositLocked       Decimal    @default(0.00000000) @db.Decimal(20, 8)
  isP2pMerchant          Boolean    @default(false)
  lastLoginAt            DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  wallet                Wallet?
  kycDocuments          KycDocument[]
  refreshTokens         RefreshToken[]
  packages              InvestmentPackage[]
  packageReturns        PackageReturn[]
  withdrawals           WithdrawalRequest[]
  exchangeOrders        ExchangeOrder[]
  p2pOffers             P2POffer[]
  p2pOrdersAsBuyer      P2POrder[]          @relation("BuyerOrders")
  p2pOrdersAsSeller     P2POrder[]          @relation("SellerOrders")
  auditLogs             AdminAuditLog[]
  inquiries             Inquiry[]
  transactions          Transaction[]
  deposits              DepositRequest[]
  virtualCard           VirtualCard?
  supportTickets        SupportTicket[]
  otcDesk               OtcDesk?
  otcQuotesRequested    OtcQuote[]          @relation("CustomerOtcQuotes")
  otcTradesAsCustomer   OtcTrade[]          @relation("CustomerOtcTrades")
  otcTradesAsOperator   OtcTrade[]          @relation("OperatorOtcTrades")
  globalTransfers       GlobalTransfer[]
  tokenEarlyAccess      TokenEarlyAccess?
  fundSeekerListings    StartupListing[]    @relation("FundSeekerListings")
  investorCommitments   InvestmentCommitment[] @relation("InvestorCommitments")
  investmentWatchlist   InvestmentWatchlist[]
  investmentInquiries   InvestmentInquiry[]

  @@map("diw_users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("diw_refresh_tokens")
}

model KycDocument {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String // PASSPORT, NATIONAL_ID, DRIVERS_LICENSE, PROOF_OF_ADDRESS
  documentUrl     String    @db.VarChar(500)
  status          KycStatus @default(PENDING)
  rejectionReason String?   @db.Text
  verifiedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime  @default(now())

  @@map("diw_kyc_documents")
}

model Wallet {
  id        String          @id @default(uuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  balances  WalletBalance[]

  @@map("diw_wallets")
}

model WalletBalance {
  id                String   @id @default(uuid())
  walletId          String
  wallet            Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency          String   @db.VarChar(10) // USD, EUR, INR, GEL, USDT
  availableBalance  Decimal  @default(0.00000000) @db.Decimal(20, 8)
  lockedPrincipal   Decimal  @default(0.00000000) @db.Decimal(20, 8)
  pendingSettlement Decimal  @default(0.00000000) @db.Decimal(20, 8)
  updatedAt         DateTime @updatedAt

  @@unique([walletId, currency])
  @@map("diw_wallet_balances")
}

model LedgerAccount {
  id          String        @id @db.VarChar(60) // e.g. USER_AVAILABLE_USD, PLATFORM_TREASURY_USD
  accountName String        @db.VarChar(100)
  accountType AccountType
  currency    String        @db.VarChar(10)
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  entries     LedgerEntry[]

  @@map("diw_ledger_accounts")
}

model LedgerJournal {
  id             String               @id @default(uuid())
  idempotencyKey String               @unique @db.VarChar(100)
  referenceType  JournalReferenceType
  referenceId    String?              @db.VarChar(64)
  notes          String?              @db.Text
  createdBy      String               @default("SYSTEM") @db.VarChar(64)
  createdAt      DateTime             @default(now())
  entries        LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("diw_ledger_journals")
}

model LedgerEntry {
  id            String         @id @default(uuid())
  journalId     String
  journal       LedgerJournal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId     String         @db.VarChar(60)
  account       LedgerAccount  @relation(fields: [accountId], references: [id])
  userId        String?        @db.VarChar(36)
  direction     EntryDirection
  amount        Decimal        @db.Decimal(20, 8)
  currency      String         @db.VarChar(10)
  balanceBefore Decimal?       @db.Decimal(20, 8)
  balanceAfter  Decimal?       @db.Decimal(20, 8)
  createdAt     DateTime       @default(now())

  @@index([journalId])
  @@index([accountId])
  @@index([userId])
  @@map("diw_ledger_entries")
}

model InvestmentPackage {
  id                        String        @id @default(uuid())
  packageCode               String        @unique @db.VarChar(30) // PKG-000101
  userId                    String
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                    Decimal       @db.Decimal(20, 8)
  currency                  String        @default("USD") @db.VarChar(10)
  returnRateSnapshot        Decimal       @db.Decimal(6, 4) // e.g. 0.0100 for 1%
  lockInMonths              Int           @default(6)
  status                    PackageStatus @default(PENDING_PAYMENT)
  purchaseDate              DateTime?
  lockInStart               DateTime?
  lockInEnd                 DateTime?
  withdrawalEligibilityDate DateTime?
  depositProofUrl           String?       @db.VarChar(500)
  depositMethod             String?       @db.VarChar(50) // WALLET_BALANCE, BANK_DEPOSIT, CRYPTO_TRANSFER
  adminNotes                String?       @db.Text
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  returns     PackageReturn[]
  withdrawals WithdrawalRequest[]
  transactions Transaction[]

  @@index([userId, status])
  @@map("diw_investment_packages")
}

model PackageReturn {
  id              String            @id @default(uuid())
  packageId       String
  package         InvestmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodIndex     Int // 1, 2, 3...
  returnAmount    Decimal           @db.Decimal(20, 8)
  currency        String            @db.VarChar(10)
  payoutDate      DateTime          @default(now())
  ledgerJournalId String?           @db.VarChar(36)
  status          ReturnStatus      @default(CREDITED)
  createdAt       DateTime          @default(now())

  @@index([packageId])
  @@index([userId])
  @@map("diw_package_returns")
}

model WithdrawalRequest {
  id                  String             @id @default(uuid())
  requestCode         String             @unique @db.VarChar(30) // WTH-000101
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId           String?
  package             InvestmentPackage? @relation(fields: [packageId], references: [id])
  withdrawalType      WithdrawalType
  amount              Decimal            @db.Decimal(20, 8)
  currency            String             @db.VarChar(10)
  payoutMethod        PayoutMethod
  payoutDetails       String             @db.Text // JSON string
  status              WithdrawalStatus   @default(REQUESTED)
  requestWindowDate   DateTime // e.g. 2026-10-01
  settlementReference String?            @db.VarChar(100) // Bank UTR, TX Hash, Counter Voucher
  adminNotes          String?            @db.Text
  reviewedBy          String?
  settledAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId, status])
  @@map("diw_withdrawal_requests")
}

model ExchangePair {
  id            String   @id @default(uuid())
  baseCurrency  String   @db.VarChar(10) // USDT
  quoteCurrency String   @db.VarChar(10) // USD, EUR, INR, GEL
  baseRate      Decimal  @db.Decimal(20, 8)
  buyMarginPct  Decimal  @default(1.00) @db.Decimal(6, 4) // e.g. 1.00%
  sellMarginPct Decimal  @default(1.00) @db.Decimal(6, 4) // e.g. 1.00%
  minOrder      Decimal  @default(100.00) @db.Decimal(20, 8)
  maxOrder      Decimal  @default(50000.00) @db.Decimal(20, 8)
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency])
  @@map("diw_exchange_pairs")
}

model ExchangeOrder {
  id                 String            @id @default(uuid())
  orderCode          String            @unique @db.VarChar(30) // EXC-000101
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderType          ExchangeOrderType
  fromCurrency       String            @db.VarChar(10)
  toCurrency         String            @db.VarChar(10)
  fromAmount         Decimal           @db.Decimal(20, 8)
  toAmount           Decimal           @db.Decimal(20, 8)
  rate               Decimal           @db.Decimal(20, 8)
  feeAmount          Decimal           @db.Decimal(20, 8)
  payoutDestination  PayoutMethod
  destinationDetails String            @db.Text // JSON
  status             ExchangeStatus    @default(QUOTE_PENDING)
  depositProofUrl    String?           @db.VarChar(500)
  txHashOrUtr        String?           @db.VarChar(128)
  expiresAt          DateTime
  completedAt        DateTime?
  adminNotes         String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId, status])
  @@map("diw_exchange_orders")
}

model P2POffer {
  id              String         @id @default(uuid())
  offerCode       String         @unique @db.VarChar(30)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  side            P2PSide
  cryptoCurrency  String         @default("USDT") @db.VarChar(10)
  fiatCurrency    String         @db.VarChar(10) // USD, EUR, INR, GEL
  price           Decimal        @db.Decimal(20, 8)
  totalAmount     Decimal        @db.Decimal(20, 8)
  availableAmount Decimal        @db.Decimal(20, 8)
  minLimit        Decimal        @db.Decimal(20, 8)
  maxLimit        Decimal        @db.Decimal(20, 8)
  paymentMethods  String         @db.Text // JSON: ["Bank Transfer", "Tbilisi Cash", "Wise"]
  paymentTerms    String?        @db.Text
  status          P2POfferStatus @default(OPEN)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orders P2POrder[]

  @@map("diw_p2p_offers")
}

model P2POrder {
  id                String         @id @default(uuid())
  orderCode         String         @unique @db.VarChar(30)
  offerId           String
  offer             P2POffer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId          String
  seller            User           @relation("SellerOrders", fields: [sellerId], references: [id])
  cryptoAmount      Decimal        @db.Decimal(20, 8)
  fiatAmount        Decimal        @db.Decimal(20, 8)
  price             Decimal        @db.Decimal(20, 8)
  escrowJournalId   String?        @db.VarChar(36)
  paymentProofUrl   String?        @db.VarChar(500)
  status            P2POrderStatus @default(PENDING_PAYMENT)
  disputeReason     String?        @db.Text
  disputeResolvedBy String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  messages P2PMessage[]

  @@map("diw_p2p_orders")
}

model P2PMessage {
  id        String   @id @default(uuid())
  orderId   String
  order     P2POrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("diw_p2p_messages")
}

model CmsSetting {
  id          String   @id @default(uuid())
  group       String   @db.VarChar(50)
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@map("diw_cms_settings")
}

model CmsSection {
  id        String   @id @default(uuid())
  page      String   @db.VarChar(50)
  section   String   @db.VarChar(50)
  title     String?  @db.VarChar(255)
  subtitle  String?  @db.Text
  content   String?  @db.LongText
  metadata  String?  @db.LongText
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("diw_cms_sections")
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(150)
  title       String   @db.VarChar(255)
  summary     String   @db.Text
  content     String   @db.LongText
  coverImage  String?  @db.VarChar(500)
  authorName  String   @default("Avora Bank Research Team")
  readTime    String   @default("5 min read")
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("diw_blog_posts")
}

model Inquiry {
  id            String      @id @default(uuid())
  type          InquiryType
  name          String      @db.VarChar(100)
  email         String      @db.VarChar(191)
  phone         String?     @db.VarChar(50)
  subject       String      @db.VarChar(200)
  message       String      @db.Text
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  status        String      @default("NEW")
  adminNotes    String?     @db.Text
  forwardedMail Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("diw_inquiries")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(60)
  entityId  String?  @db.VarChar(64)
  details   String?  @db.Text
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([action, entity])
  @@map("diw_admin_audit_logs")
}

model Transaction {
  id                  String            @id @default(uuid())
  transactionCode     String            @unique @db.VarChar(36)
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId           String?
  package             InvestmentPackage? @relation(fields: [packageId], references: [id])
  type                TransactionType
  amount              Decimal           @db.Decimal(20, 8)
  currency            String            @default("USD") @db.VarChar(10)
  status              TransactionStatus @default(COMPLETED)
  balanceBefore       Decimal           @db.Decimal(20, 8)
  balanceAfter        Decimal           @db.Decimal(20, 8)
  settlementReference String?           @db.VarChar(128)
  createdBy           String            @default("SYSTEM") @db.VarChar(64)
  idempotencyKey      String?           @unique @db.VarChar(128)
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@map("diw_transactions")
}

model DepositRequest {
  id             String        @id @default(uuid())
  depositCode    String        @unique @db.VarChar(36)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(20, 8)
  currency       String        @default("USD") @db.VarChar(10)
  depositMethod  String        @db.VarChar(50)
  proofUrl       String?       @db.VarChar(500)
  txHashOrRef    String?       @db.VarChar(128)
  status         DepositStatus @default(PENDING)
  adminNotes     String?       @db.Text
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@map("diw_deposits")
}

model VirtualCard {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalCardId       String?  @unique @map("external_card_id") @db.VarChar(128)
  externalCardholderId String?  @map("external_cardholder_id") @db.VarChar(128)
  last4                String   @default("0000") @db.VarChar(4)
  expMonth             Int      @default(8) @map("exp_month")
  expYear              Int      @default(2029) @map("exp_year")
  brand                String   @default("visa") @db.VarChar(20)
  cardNumberMask       String   @default("•••• •••• •••• 0000") @db.VarChar(30)
  cardHolderName       String   @db.VarChar(100)
  expiryDate           String   @default("08/29") @db.VarChar(10)
  cvvEncrypted         String?  @db.VarChar(255)
  cardTheme            String   @default("redot") @db.VarChar(20)
  cardNetwork          String   @default("visa") @db.VarChar(20)
  isFrozen             Boolean  @default(false)
  dailyLimit           Decimal  @default(10000.00) @db.Decimal(20, 2)
  monthlyLimit         Decimal  @default(50000.00) @db.Decimal(20, 2)
  onlineEnabled        Boolean  @default(true)
  intlEnabled          Boolean  @default(true)
  atmEnabled           Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("diw_virtual_cards")
}

model SupportTicket {
  id           String        @id @default(uuid())
  ticketNumber String        @unique @db.VarChar(30)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String        @db.VarChar(50)
  priority     String        @default("MEDIUM") @db.VarChar(20)
  status       String        @default("OPEN") @db.VarChar(30)
  subject      String        @db.VarChar(200)
  message      String        @db.Text
  adminNotes   String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  replies      TicketReply[]

  @@index([userId, status])
  @@map("diw_support_tickets")
}

model TicketReply {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  senderName String        @db.VarChar(100)
  senderRole String        @default("USER") @db.VarChar(20)
  message    String        @db.Text
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("diw_ticket_replies")
}

model OtcDesk {
  id                  String     @id @default(uuid())
  deskCode            String     @unique @db.VarChar(30) // OTC-CMB-001
  userId              String     @unique
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deskName            String     @db.VarChar(100)
  country             String     @db.VarChar(60) // Sri Lanka, UAE, Georgia, India...
  countryCode         String     @db.VarChar(10) // LK, AE, GE, IN...
  city                String     @db.VarChar(60) // Colombo, Dubai, Tbilisi...
  locationAddress     String?    @db.VarChar(255)
  supportedCurrencies String     @db.VarChar(100) // JSON or comma: ["LKR", "USDT", "USD"]
  settlementMethods   String     @db.Text // JSON: ["Cash Pickup", "Commercial Bank", "Sampath Bank"]
  securityDeposit     Decimal    @default(1000.00000000) @db.Decimal(20, 8) // $1,000 locked
  depositStatus       String     @default("ACTIVE") // ACTIVE, REFUND_REQUESTED, REFUNDED, FORFEITED
  isOnline            Boolean    @default(true)
  buyRateMarginPct    Decimal    @default(1.00) @db.Decimal(6, 4) // Operator markup (1.0% default)
  sellRateMarginPct   Decimal    @default(1.00) @db.Decimal(6, 4)
  totalTrades         Int        @default(0)
  completedTrades     Int        @default(0)
  cancelledTrades     Int        @default(0)
  rating              Decimal    @default(5.00) @db.Decimal(3, 2)
  status              String     @default("ACTIVE") // ACTIVE, UNDER_REVIEW, SUSPENDED, CLOSED
  adminNotes          String?    @db.Text
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  quotes              OtcQuote[]
  trades              OtcTrade[]

  @@index([countryCode, city, isOnline, status])
  @@map("diw_otc_desks")
}

model OtcQuote {
  id           String    @id @default(uuid())
  quoteCode    String    @unique @db.VarChar(30) // QTE-00101
  deskId       String
  desk         OtcDesk   @relation(fields: [deskId], references: [id], onDelete: Cascade)
  customerId   String
  customer     User      @relation("CustomerOtcQuotes", fields: [customerId], references: [id])
  tradeType    String    // BUY_USDT, SELL_USDT
  cryptoAmount Decimal   @db.Decimal(20, 8)
  fiatAmount   Decimal   @db.Decimal(20, 8)
  fiatCurrency String    @db.VarChar(10)
  quotedRate   Decimal   @db.Decimal(20, 8)
  operatorFee  Decimal   @db.Decimal(20, 8) // 1.0%
  platformFee  Decimal   @db.Decimal(20, 8) // 0.5%
  totalFee     Decimal   @db.Decimal(20, 8) // 1.5%
  status       String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  trade        OtcTrade?

  @@index([deskId, customerId, status])
  @@map("diw_otc_quotes")
}

model OtcTrade {
  id              String       @id @default(uuid())
  tradeCode       String       @unique @db.VarChar(30) // TRD-00101
  quoteId         String       @unique
  quote           OtcQuote     @relation(fields: [quoteId], references: [id])
  deskId          String
  desk            OtcDesk      @relation(fields: [deskId], references: [id])
  customerId      String
  customer        User         @relation("CustomerOtcTrades", fields: [customerId], references: [id])
  operatorId      String
  operator        User         @relation("OperatorOtcTrades", fields: [operatorId], references: [id])
  tradeType       String       // BUY_USDT, SELL_USDT
  cryptoAmount    Decimal      @db.Decimal(20, 8)
  fiatAmount      Decimal      @db.Decimal(20, 8)
  fiatCurrency    String       @db.VarChar(10)
  quotedRate      Decimal      @db.Decimal(20, 8)
  operatorFee     Decimal      @db.Decimal(20, 8) // 1.0%
  platformFee     Decimal      @db.Decimal(20, 8) // 0.5%
  escrowLocked    Boolean      @default(true)
  escrowJournalId String?      @db.VarChar(36)
  paymentProofUrl String?      @db.VarChar(500)
  status          String       @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DISPUTED, CANCELLED
  disputeReason   String?      @db.Text
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  messages        OtcMessage[]

  @@index([deskId, customerId, status])
  @@map("diw_otc_trades")
}

model OtcMessage {
  id         String   @id @default(uuid())
  tradeId    String
  trade      OtcTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId   String
  senderName String   @db.VarChar(100)
  message    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([tradeId, createdAt])
  @@map("diw_otc_messages")
}

// ============================================================================
// GLOBAL MONEY TRANSFER (7. Global Money Transfer Service)
// ============================================================================
model GlobalTransfer {
  id                     String    @id @default(uuid())
  transferCode           String    @unique @db.VarChar(30) // GMT-2026-XXXX
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderName             String    @db.VarChar(150)
  senderEmail            String    @db.VarChar(150)
  sendingCurrency        String    @db.VarChar(10) // USD, EUR, GBP, AED, USDT
  sendingAmount          Decimal   @db.Decimal(20, 8)
  destinationCountry     String    @db.VarChar(100)
  destinationCountryCode String    @db.VarChar(10)
  recipientCurrency      String    @db.VarChar(10) // INR, LKR, AED, GEL, EUR, GBP, USD
  recipientAmount        Decimal   @db.Decimal(20, 8)
  recipientName          String    @db.VarChar(150)
  recipientAccount       String    @db.VarChar(100)
  recipientBankName      String    @db.VarChar(150)
  recipientBicSwift      String?   @db.VarChar(50)
  recipientAddress       String?   @db.VarChar(255)
  transferReason         String?   @db.VarChar(255)
  referenceRate          Decimal   @db.Decimal(20, 8)
  rateAdjustmentPct      Decimal   @default(2.00) @db.Decimal(5, 2) // 2.0%
  effectiveRate          Decimal   @db.Decimal(20, 8)
  transferFeePct         Decimal   @default(3.00) @db.Decimal(5, 2) // 3.0%
  transferFeeAmount      Decimal   @db.Decimal(20, 8)
  totalPaidAmount        Decimal   @db.Decimal(20, 8)
  status                 String    @default("SUBMITTED") // SUBMITTED, COMPLIANCE_SCREENED, PROCESSING, COMPLETED, REJECTED, REFUNDED
  estimatedDeliveryDate  DateTime
  trackingTimeline       String?   @db.Text
  complianceNotes        String?   @db.Text
  rejectionReason        String?   @db.Text
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, status])
  @@index([transferCode])
  @@map("diw_global_transfers")
}

// ============================================================================
// AVORA TOKEN (8. Avora Token - Early Access & Future Mainnet Launch)
// ============================================================================
model TokenEarlyAccess {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  testnetBalance         Decimal   @default(0.00000000) @db.Decimal(20, 8)
  lastFaucetClaimAt      DateTime?
  registeredInterest     Boolean   @default(false)
  requestedAllocationUsd Decimal   @default(0.00) @db.Decimal(20, 2)
  status                 String    @default("REGISTERED") // REGISTERED, WHITELISTED, ALLOCATED
  walletAddress          String?   @db.VarChar(100)
  notes                  String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("diw_token_early_access")
}

// ============================================================================
// AVORA INVESTMENTS (Funding Marketplace & Investor Dashboard)
// ============================================================================
model StartupListing {
  id                  String                 @id @default(uuid())
  slug                String                 @unique @db.VarChar(120)
  companyName         String                 @db.VarChar(150)
  tagline             String                 @db.VarChar(255)
  logoUrl             String?                @db.VarChar(500)
  coverImageUrl       String?                @db.VarChar(500)
  country             String                 @db.VarChar(100)
  countryCode         String                 @db.VarChar(10)
  city                String                 @db.VarChar(100)
  industry            String                 @db.VarChar(100)
  stage               String                 @default("SEED") // PRE_SEED, SEED, SERIES_A, GROWTH
  instrument          String                 @default("SAFE") // SAFE, EQUITY, DEBT, REVENUE_SHARE, TOKEN
  valuation           Decimal                @db.Decimal(20, 2)
  fundingTarget       Decimal                @db.Decimal(20, 2)
  minInvestment       Decimal                @default(250.00) @db.Decimal(20, 2)
  verifiedFundsRaised Decimal                @default(0.00) @db.Decimal(20, 2)
  investorCount       Int                    @default(0)
  deadline            DateTime
  status              String                 @default("PUBLISHED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, PUBLISHED, CLOSED, SUSPENDED
  dueDiligenceStatus  String                 @default("VERIFIED") // PENDING, UNDER_REVIEW, VERIFIED, REJECTED
  dueDiligenceSummary String?                @db.Text
  dueDiligenceDate    DateTime?
  pitchOverview       String                 @db.Text
  problemSolution     String?                @db.Text
  businessModel       String?                @db.Text
  marketOpportunity   String?                @db.Text
  useOfFunds          String?                @db.Text
  milestones          String?                @db.Text
  financialHighlights String?                @db.Text
  founders            String?                @db.Text
  pitchDeckUrl        String?                @db.VarChar(500)
  allocationFeePct    Decimal                @default(5.00) @db.Decimal(5, 2) // 5% Investment Allocation Fee
  profitShareFeePct   Decimal                @default(5.00) @db.Decimal(5, 2) // 5% Profit-Sharing Fee
  fundSeekerUserId    String?
  fundSeeker          User?                  @relation("FundSeekerListings", fields: [fundSeekerUserId], references: [id])
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  investments         InvestmentCommitment[]
  watchlistUsers      InvestmentWatchlist[]
  inquiries           InvestmentInquiry[]

  @@index([industry, status])
  @@index([countryCode, status])
  @@map("diw_startup_listings")
}

model InvestmentCommitment {
  id                   String         @id @default(uuid())
  investmentCode       String         @unique @db.VarChar(30) // INV-2026-XXXX
  listingId            String
  listing              StartupListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  investorUserId       String
  investor             User           @relation("InvestorCommitments", fields: [investorUserId], references: [id])
  grossAmount          Decimal        @db.Decimal(20, 2)
  allocationFeePct     Decimal        @default(5.00) @db.Decimal(5, 2) // 5%
  allocationFeeAmount  Decimal        @db.Decimal(20, 2)
  netInvestedAmount    Decimal        @db.Decimal(20, 2)
  instrument           String         @default("SAFE")
  ownershipPct         Decimal?       @db.Decimal(8, 4)
  status               String         @default("CLEARED_FUNDS") // EXPRESSION_OF_INTEREST, DOCUMENT_SIGNED, CLEARED_FUNDS, ACTIVE, EXITED, CANCELLED
  currentValuation     Decimal?       @db.Decimal(20, 2)
  unrealizedReturnPct  Decimal?       @db.Decimal(8, 2)
  realizedProceeds     Decimal        @default(0.00) @db.Decimal(20, 2)
  returnOfCapital      Decimal        @default(0.00) @db.Decimal(20, 2)
  eligibleNetProfit    Decimal        @default(0.00) @db.Decimal(20, 2)
  profitShareFeePct    Decimal        @default(5.00) @db.Decimal(5, 2) // 5%
  profitShareFeeAmount Decimal        @default(0.00) @db.Decimal(20, 2)
  netDistributedProfit Decimal        @default(0.00) @db.Decimal(20, 2)
  settlementReference  String?        @db.VarChar(50)
  notes                String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([investorUserId, status])
  @@index([listingId])
  @@map("diw_investment_commitments")
}

model InvestmentWatchlist {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   StartupListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, listingId])
  @@map("diw_investment_watchlist")
}

model InvestmentInquiry {
  id             String         @id @default(uuid())
  listingId      String
  listing        StartupListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  investorUserId String
  investor       User           @relation(fields: [investorUserId], references: [id], onDelete: Cascade)
  type           String         @default("QUESTION") // QUESTION, INTRO_REQUEST, DOC_REQUEST
  subject        String         @db.VarChar(150)
  message        String         @db.Text
  response       String?        @db.Text
  status         String         @default("PENDING") // PENDING, RESPONDED, CLOSED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([listingId, status])
  @@map("diw_investment_inquiries")
}
