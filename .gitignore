# Dependencies
node_modules/
*/node_modules/
apps/*/node_modules/
package-lock.json
apps/*/package-lock.json

# Next.js build outputs
.next/
apps/web/.next/
out/
apps/web/out/

# Build and compilation outputs
dist/
apps/server/dist/
build/
*.tsbuildinfo
.eslintcache

# Environment & credentials (NEVER commit secrets or env files)
.env
.env*
!.env.example
apps/*/.env
apps/*/.env*
!apps/*/.env.example

# Database dumps, migrations scratch, and SQL files
*.sql
*.sqlite
*.sqlite3
apps/server/*.sql
apps/server/apply_schema.js
apps/server/check_db.js
apps/server/src/scripts/

# Uploads and media volume
uploads/*
apps/server/uploads/*
!apps/server/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.bak
*~

# Temporary scratch scripts
test_write.js
scratch/
.system_generated/
