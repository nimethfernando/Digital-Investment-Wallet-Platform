# Dependencies (matches at root and all subdirectories like apps/server and apps/web)
node_modules/
**/node_modules/
package-lock.json
**/package-lock.json
.pnpm-store/

# Next.js build outputs and caches
.next/
**/.next/
out/
**/out/

# Build and compilation outputs
dist/
**/dist/
build/
**/build/
.temp/
.tmp/
*.tsbuildinfo
.eslintcache

# Environment variables & secrets (NEVER commit credentials)
.env
.env*
**/.env
**/.env*
!.env.example
!**/.env.example

# Database dumps, migrations scratch, and SQL files
*.sql
**/*.sql
*.sqlite
*.sqlite3
apps/server/apply_schema.js
apps/server/check_db.js
apps/server/src/scripts/

# Uploads & media volumes
uploads/
**/uploads/
!**/uploads/.gitkeep

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.bak
*~

# Temporary scratch scripts
test_write.js
scratch/
.system_generated/
